# ─── MedBridge Monorepo .gitignore ───

# Environment and sensitive keys
.env
.env.*
*.env
*.env.local

# Backend builds and modules
backend/node_modules/
backend/dist/
backend/.env

# Frontend builds and modules
frontend/.next/
frontend/node_modules/
frontend/out/
frontend/build/
frontend/.env.local

# Agent skills and lock files
.agents/
.claude/
.kiro/
frontend/.agents/
frontend/.kiro/
skills-lock.json

# Local notes and docs (kept off GitHub per project policy)
gpt edits.md
resume_alignment.md
fontendprogress.md
docs/
*.md
!README.md
frontend/*.md
backend/*.md

# System & OS
.DS_Store
Thumbs.db
*.tsbuildinfo
*.log